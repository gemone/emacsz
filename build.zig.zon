.{
    .name = .emacs,
    .fingerprint = 0x9075990b2e14f4b3,
    .version = "31.0.50",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The Gnulib .gl.h generator, extracted as an independent Zig
        // package (the first zon dependency; runtime gnulib/platform
        // packages will follow the same pattern).
        .gl_headers_gen = .{
            .path = "tools/gl-headers",
        },
        // config-probe: the diagnostic host prober (`zig build
        // probe-config`).  Reports the host's headers/functions via `zig
        // cc` compile probes; does NOT feed config.h (which is generated
        // deterministically by b.addConfigHeader in build.zig).
        .config_probe = .{
            .path = "tools/config-probe",
        },
        // The complete-DEF collector: config-collect SIMD-scans any config
        // file for every `#define`/`#undef` and emits the sorted-unique
        // knob set (template/universe/answer completeness instrument).
        .config_collect = .{
            .path = "tools/config-collect",
        },
        // The native-comp Zig tool (HAVE_NATIVE_COMP_ZIG path): parses a
        // zunit, emits LLVM IR, drives `zig cc -shared` to produce `.zeln`.
        // Skeleton at scaffold stage; run when -Dnative-comp-zig=true (M0+).
        .zeln_compile = .{
            .path = "tools/zeln-compile",
        },
        // The src/epaths.h generator, extracted as an independent Zig
        // package (mirrors the addConfigHeader config.h generation above;
        // formats the 11 PATH_* macros
        // from the absolute repo root passed as argv[1]).
        .gen_epaths = .{
            .path = "tools/gen-epaths",
        },
        // gnulib-str: gnulib string-primitive functions (memeq, streq)
        // provided by an independent Zig package instead of C
        // (lib/memeq.c, lib/streq.c). Linked into temacs to replace the
        // gnulib `extern inline` external definitions; direct byte/string
        // loops with no libc call. Follows the same path-dep pattern as the
        // build-time tool packages above.
        .gnulib_str = .{
            .path = "tools/gnulib-str",
        },
        // gnulib-ctype: gnulib's c-ctype character-classification
        // functions (c_isalpha, c_isdigit, c_tolower, ...) provided by an
        // independent Zig package instead of C (lib/c-ctype.c). Linked
        // into temacs; ASCII-only, exact semantic match, no libc call.
        .gnulib_ctype = .{
            .path = "tools/gnulib-ctype",
        },
        // gnulib-stdbit: gnulib's C23 <stdbit.h> bit-count functions
        // (stdc_leading_zeros/_trailing_zeros/_count_ones/_bit_width,
        // each _uc/_us/_ui/_ul/_ull) provided by an independent Zig
        // package instead of C (lib/stdc_*.c). Linked into temacs; exact
        // semantic match via @clz/@ctz/@popCount, no libc call.
        .gnulib_stdbit = .{
            .path = "tools/gnulib-stdbit",
        },
        // gnulib-hash: gnulib's cryptographic hashes (SHA1 first) provided
        // by an independent Zig package instead of C (lib/sha1.c). A
        // native Zig SHA1 operating on the gnulib struct sha1_ctx layout;
        // no libc call. Linked into temacs (backs `secure-hash').
        .gnulib_hash = .{
            .path = "tools/gnulib-hash",
        },
        // gnulib-sig2str: gnulib's signal name<->number conversion
        // (sig2str / str2sig, lib/sig2str.c) provided by an independent
        // Zig package instead of C. Pure table + string handling with
        // per-platform signal tables; no libc call. Linked into temacs
        // (backs signal-names and process signal parsing).
        .gnulib_sig2str = .{
            .path = "tools/gnulib-sig2str",
        },
        // gnulib-filemode: gnulib's file-mode string helpers (strmode,
        // filemodestring, lib/filemode.c) provided by an independent
        // Zig package instead of C. Pure string logic; no libc call.
        // Linked into temacs (backs file-attributes string mode element).
        .gnulib_filemode = .{
            .path = "tools/gnulib-filemode",
        },
        // gnulib-timespec: gnulib's timespec arithmetic (dtotimespec,
        // timespec_add, timespec_sub; lib/dtotimespec.c, lib/timespec-add.c,
        // lib/timespec-sub.c) provided by an independent Zig package
        // instead of C. Pure arithmetic; no libc call. Linked into temacs
        // (backs sit-for/sleep timeouts and gc timing).
        .gnulib_timespec = .{
            .path = "tools/gnulib-timespec",
        },
        // gnulib-filevercmp: gnulib's version-sort file name comparison
        // (filevercmp / filenvercmp, lib/filevercmp.c) provided by an
        // independent Zig package instead of C. Pure string logic; no
        // libc call. Linked into temacs (backs `string-version-lessp').
        .gnulib_filevercmp = .{
            .path = "tools/gnulib-filevercmp",
        },
        // gnulib-sigdescr-np: gnulib's signal description strings
        // (sigdescr_np, lib/sigdescr_np.c) provided by an independent
        // Zig package instead of C. Static per-platform tables; no libc
        // call. Linked into temacs (backs safe_strsignal error output).
        .gnulib_sigdescr_np = .{
            .path = "tools/gnulib-sigdescr-np",
        },
        // gnulib-nproc: gnulib's processor-count query (num_processors,
        // lib/nproc.c) provided by an independent Zig package instead of
        // C. Affinity/scheduler via raw syscalls, sysfs/proc reads and
        // cgroup-v2 quota parsing; no libc call. Linked into temacs
        // (backs `num-processors').
        .gnulib_nproc = .{
            .path = "tools/gnulib-nproc",
        },
        // gnulib-tempname: gnulib's temporary-name generation
        // (gen_tempname / gen_tempname_len / mkostemp, lib/tempname.c +
        // lib/mkostemp.c) provided by an independent Zig package instead
        // of C. getrandom with clock fallback, raw openat/mkdir/lstat
        // syscalls; no libc call. Linked into temacs (backs
        // `make-temp-file' and filelock).
        .gnulib_tempname = .{
            .path = "tools/gnulib-tempname",
        },
        // msvc-posix: MSVC-backend-only provider of the POSIX-name
        // file/dir functions the UCRT does not export (_open/_close/_mkdir/
        // _unlink/_getcwd/_stati64 aliases), for the command-line tools
        // (emacsclient/etags) and the Zig gnulib-tempname package.  Linked
        // only under -Dtarget=*-windows-msvc.  MinGW exports both spellings,
        // so the default GNU backend never needs it.
        .msvc_posix = .{
            .path = "tools/msvc-posix",
        },
        // gnulib-fsusage: gnulib's file-system space query
        // (get_fs_usage, lib/fsusage.c) provided by an independent Zig
        // package instead of C. Raw statfs syscall; no libc call.
        // Linked into temacs (backs `file-system-info').
        .gnulib_fsusage = .{
            .path = "tools/gnulib-fsusage",
        },
        // gnulib-getloadavg: gnulib's load-average query (getloadavg,
        // lib/getloadavg.c) provided by an independent Zig package
        // instead of C. Raw sysinfo syscall; no libc call. Linked into
        // temacs (backs `load-average').
        .gnulib_getloadavg = .{
            .path = "tools/gnulib-getloadavg",
        },
        // gnulib-careadlinkat: gnulib's symlink reader (careadlinkat,
        // lib/careadlinkat.c) provided by an independent Zig package
        // instead of C. Uses the caller's readlink callback and
        // allocator; no libc call on the Emacs path. Linked into temacs
        // (backs `file-symlink-p' and `file-truename').
        .gnulib_careadlinkat = .{
            .path = "tools/gnulib-careadlinkat",
        },
        // gnulib-dtoastr: gnulib's accurate float-to-string conversion
        // (dtoastr, lib/ftoastr.c instantiated for double) provided by an
        // independent Zig package instead of C. Exact digits via zig
        // std, round-half-even %g formatting and a parseFloat round-trip
        // check; no libc call. Linked into temacs (backs float printing).
        .gnulib_dtoastr = .{
            .path = "tools/gnulib-dtoastr",
        },
        // gnulib-stat-time: gnulib's struct stat timestamp accessors
        // (get_stat_atime/mtime/ctime[/ns], lib/stat-time.c) provided by
        // an independent Zig package instead of C. Pure struct reads; no
        // libc call. Linked into temacs (backs `file-attributes' times).
        .gnulib_stat_time = .{
            .path = "tools/gnulib-stat-time",
        },
        // gnulib-boot-time: gnulib's boot-time query (get_boot_time,
        // lib/boot-time.c) provided by an independent Zig package instead
        // of C. utmp scan + boot-touched-file + CLOCK_BOOTTIME chain via
        // raw syscalls and file reads; no libc call. Linked into temacs
        // (backs lock-file identification).
        .gnulib_boot_time = .{
            .path = "tools/gnulib-boot-time",
        },
        // gnulib-c-strcase: gnulib's ASCII case-insensitive string
        // comparison (c_strcasecmp / c_strncasecmp, lib/c-strcasecmp.c +
        // lib/c-strncasecmp.c) provided by an independent Zig package
        // instead of C. Pure byte logic; no libc call. Linked into
        // temacs (backs `-exe' detection and font matching).
        .gnulib_c_strcase = .{
            .path = "tools/gnulib-c-strcase",
        },
        // gnulib-acl: gnulib's ACL copying for preserve-permissions
        // (lib/qcopy-acl.c under USE_XATTR) provided by an independent
        // Zig package instead of C. Linux xattr copy (attr_copy_file /
        // attr_copy_fd semantics with the is_attr_permissions filter,
        // /etc/xattr.conf actions) plus the fdfile_has_aclinfo EOPNOTSUPP
        // diagnostic, all via raw syscalls with no libc call. Linked
        // into temacs (backs `Fcopy_file' with preserve-permissions).
        .gnulib_acl = .{
            .path = "tools/gnulib-acl",
        },
        // gnulib-time-rz: gnulib's time zone management (tzalloc /
        // tzfree / set_tz / revert_tz / localtime_rz / mktime_z,
        // lib/time_rz.c) provided by an independent Zig package
        // instead of C. Replicates the struct-tm_zone abbreviation
        // cache and the TZ environment swap on top of Emacs's own
        // TZ getter/setter (emacs_getenv_TZ / emacs_setenv_TZ) and
        // libc's tzset/localtime_r/mktime. Linked into temacs (backs
        // `format-time-string' / `decode-time' with time zones).
        .gnulib_time_rz = .{
            .path = "tools/gnulib-time-rz",
        },
        // gnulib-io: the remaining live gnulib I/O wrappers
        // (close_stream, set_binary_mode, rpl_pipe2 from
        // lib/close-stream.c, lib/binary-io.c and lib/pipe2.c) provided
        // by an independent Zig package instead of C. Backs
        // src/sysdep.c (exit-time flush, emacs_pipe) and
        // `set-binary-mode'; the FILE* calls delegate to libc like the
        // C code, while the pipe/fcntl work uses raw Linux syscalls.
        // Linked into temacs.
        .gnulib_io = .{
            .path = "tools/gnulib-io",
        },
        // emacs-dynlib: the Track-B B-Z dynamic-module LOADER
        // (HAVE_MODULES_ZIG), the native-linking parallel to the upstream
        // HAVE_MODULES subsystem (which compiles src/dynlib.c).  An
        // independent Zig package exporting the exact 7 dynlib_* names from
        // src/dynlib.h as C-ABI `export fn`, backed by libc
        // dlopen/dlsym/dlclose/dlerror/dladdr (α slice; routes the load
        // through ld.so, NOT a raw-syscall ELF loader -- that is γ).  Linked
        // into temacs ONLY under -Dmodules-zig on a POSIX target; when it
        // supplies the provider, src/dynlib.c is dropped from the compile
        // (the package's export symbols satisfy the identical dynlib.h
        // contract at link time).  Off by default => zero footprint.
        .emacs_dynlib = .{
            .path = "tools/emacs-dynlib",
        },
        // gen-emacs-module-h: generates the gitignored src/emacs-module.h
        // from the committed src/emacs-module.in.h + module-env-* snippets
        // (upstream's AC_CONFIG_FILES), needed by the dynamic-module build.
        .gen_emacs_module_h = .{
            .path = "tools/gen-emacs-module-h",
        },
        // emacs-time: gnulib's realtime-clock read (gettime /
        // current_timespec, lib/gettime.c) provided by an independent
        // Zig package with per-platform NATIVE backends (Linux raw
        // clock_gettime syscall; Windows kernel32 GetSystemTimeAsFileTime),
        // no libc. The first OS-layer subsystem ported under the "replace
        // the POSIX/sysdep layer with zig stdlib" strategy.
        .emacs_time = .{
            .path = "tools/emacs-time",
        },
        // emacs-nanosleep: gnulib's nanosleep (lib/nanosleep.c) provided
        // by an independent Zig package with per-platform NATIVE backends,
        // no libc: Linux std.os.linux.nanosleep raw syscall; Windows
        // kernel32 Sleep + QueryPerformanceCounter busy-wait. The second
        // OS-layer subsystem ported under the "replace the POSIX/sysdep
        // layer with zig stdlib" strategy.
        .emacs_nanosleep = .{
            .path = "tools/emacs-nanosleep",
        },
        // bignum: GMP-compatible integer arithmetic (the mpz_* surface
        // Emacs's src/bignum.c uses) provided by an independent Zig
        // package instead of -lgmp, so the link no longer needs a
        // system GMP and Windows has no gmp.h dependency. C-ABI
        // compatible (mpz_t layout + mp_set_memory_functions); the
        // foundation slice (lifecycle/conversions/compare/add/sub/mul/
        // shifts) is in place, the rest of the surface lands in
        // follow-up slices before temacs links it.
        .bignum = .{
            .path = "tools/bignum",
        },
        // zlib: the compression library, fetched by zig and compiled with
        // zig cc into the static libz that replaces the system-installed
        // library (zig-managed dependency).
        .zlib_src = .{
            .url = "https://github.com/madler/zlib/archive/refs/tags/v1.3.1.tar.gz",
            .hash = "N-V-__8AAB0eQwD-0MdOEBmz7intriBReIsIDNlukNVoNu6o",
        },
        // SQLite: the database library, fetched by zig and compiled with
        // zig cc (amalgamation) into the static libsqlite3 that replaces
        // the system-installed library.
        .sqlite_src = .{
            .url = "https://sqlite.org/2025/sqlite-autoconf-3500200.tar.gz",
            .hash = "N-V-__8AAOPlvAALuSJh_gqzcnf5pdEL2fLS_zEi8TPxQYDJ",
        },
        // Little CMS: the color-management library, fetched by zig and
        // compiled with zig cc into the static liblcms2 that replaces the
        // system-installed library.
        .lcms2_src = .{
            .url = "https://github.com/mm2/Little-CMS/archive/refs/tags/lcms2.17.tar.gz",
            .hash = "N-V-__8AAFoTpADc6ISFB0o4tCLbYUI8NXZdYGCpgqAlQrsQ",
        },
        // Tree-sitter: the parsing library backing `treesit-*' (src/treesit.c).
        // Fetched by zig and built with tree-sitter's own Zig-native
        // build.zig (0.16 API) into the static libtree-sitter that replaces
        // the system-installed library. Pinned to the master commit
        // 308aee0c9 (version 0.27.0): the only tree-sitter revision whose
        // build.zig targets Zig 0.16 (v0.26.11 and earlier still use the
        // 0.15 API and fail with Zig 0.16).
        .tree_sitter = .{
            .url = "https://github.com/tree-sitter/tree-sitter/archive/308aee0c90b0527b185b3100046781d69935c5c5.tar.gz",
            .hash = "tree_sitter-0.27.0-Tw2sRyInDABGKEDtbdaXPvz52f0cFYqTIuTKdsHKVA5g",
        },
        // libxml2: the XML parser backing `libxml-parse-xml-region' and
        // `libxml-parse-html-region' (src/xml.c). Fetched by zig and
        // compiled with zig cc into the static libxml2 that replaces the
        // system-installed library. The configure-generated
        // include/libxml/xmlversion.h is produced from the vendored
        // template via zig's addConfigHeader (autoconf @VAR@ style).
        .xml2_src = .{
            .url = "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.3.tar.xz",
            .hash = "N-V-__8AAGkIggL0prR3gvyXGozgwaS9Gmq1QoJmCjqqwEnB",
        },
        // nettle: the crypto backend for GnuTLS (hashes, ciphers, public
        // key), fetched by zig and compiled with zig cc into the static
        // libnettle (with its bundled mini-gmp, so no external GMP).
        // Configure-generated config.h/version.h are committed under
        // tools/gnutls-config (macOS aarch64 reference build).
        .nettle_src = .{
            .url = "https://ftp.gnu.org/gnu/nettle/nettle-3.10.2.tar.gz",
            .hash = "N-V-__8AADwFewBo6OJWkkth2AnOW9eVOt3svhCtS7ga_OQc",
            // Lazy: built only when target+host are both macOS (build.zig
            // gates nettle/gnutls/ncurses on that), so don't eagerly fetch
            // these flaky-host (ftp.gnu.org / gnupg.org) tarballs for
            // Linux/Windows/musl cross builds that never use them.
            .lazy = true,
        },
        // gnutls: the TLS library backing `gnutls-*' (src/gnutls.c).
        // Fetched by zig and compiled with zig cc (minitasn1 + vendored
        // unistring + nettle backend; no p11-kit/tpm/pkcs11/idn2/zlib)
        // into the static libgnutls that replaces the system-installed
        // library. Configure-generated config.h + gnutls.h + gnulib and
        // unistring headers are committed under tools/gnutls-config.
        .gnutls_src = .{
            // gnupg.org's canonical URL 403s from CI runners (WAF);
            // mirrorservice.org serves the byte-identical tarball (hash
            // verified via `zig fetch`).
            .url = "https://www.mirrorservice.org/sites/ftp.gnupg.org/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz",
            .hash = "N-V-__8AAH0-EAR3RviaBbm3AeH1WBMFsgm_sQIS_InlvfyY",
            .lazy = true,
        },
        // ncurses: the terminfo/termcap library backing terminal UI on
        // Unix-likes (src/term.c tiget* + tgetent).  Fetched by zig and
        // compiled with zig cc into the static libncurses that replaces
        // the system-installed library on macOS.  The configure-generated
        // headers (curses.h, term.h, config.h, ...) and the generated
        // capability tables (codes.c, comp_captab.c, names.c, ...) are
        // committed under tools/ncurses-config.
        .ncurses_src = .{
            .url = "https://ftp.gnu.org/gnu/ncurses/ncurses-6.4.tar.gz",
            .hash = "N-V-__8AAHWSEwGDuK7Qx8Q-Mx6pjeYBBX9g8I6uJ9r5DZ9L",
            .lazy = true,
        },
        // Image-library sources (objective 3.5), fetched by zig and compiled
        // with zig cc.  These back src/image.c, which the current console/TTY
        // build does not compile (GUI is out of the console scope), so they
        // are declared here -- versions + content hashes locked, fetchable on
        // demand -- and will be wired (compile + link) when the GUI/image path
        // is enabled.  lazy = true: not downloaded unless build.zig calls
        // b.dependency() on them, so a console build pays no cost.
        .png_src = .{
            .url = "https://github.com/pnggroup/libpng/archive/refs/tags/v1.6.47.tar.gz",
            .hash = "N-V-__8AALj-XgA044hQcz2biR55YBJHsz1kKk5UkLAWkI-Z",
            .lazy = true,
        },
        .jpeg_src = .{
            .url = "https://www.ijg.org/files/jpegsrc.v9f.tar.gz",
            .hash = "N-V-__8AAB8MRQC7z9yHiE9h4hkpythIQIYO9BkbbEAO27AL",
            .lazy = true,
        },
        .tiff_src = .{
            .url = "https://download.osgeo.org/libtiff/tiff-4.7.0.tar.gz",
            .hash = "N-V-__8AAAM81QCqAQGOVIXueDuVtaj5gRptG5zJ4QoGrHLQ",
            .lazy = true,
        },
        // giflib 5.2.2: GIF decode/encode (HAVE_GIF; -Dwith-gif).
        .gif_src = .{
            .url = "https://sourceforge.net/projects/giflib/files/giflib-5.2.2.tar.gz/download",
            .hash = "N-V-__8AAI4GIwD_4QAQ2PcKUSZ8F2XH_vDa4da8cUxuuOU9",
            .lazy = true,
        },
        // libwebp 1.5.0: WebP decode/encode + animations (HAVE_WEBP;
        // -Dwith-webp).  Compiled WITHOUT -DHAVE_CONFIG_H: the sources
        // take their defaults (plain-C dsp fallback).
        .webp_src = .{
            .url = "https://github.com/webmproject/libwebp/archive/refs/tags/v1.5.0.tar.gz",
            .hash = "N-V-__8AAOM4egDNF1p7XMh92AC7yc-Da9ArradyeGsfMXkm",
            .lazy = true,
        },
        // libXpm 3.5.17: XPM pixmaps.  Built through the upstream FOR_MSW
        // simulation layer (src/simx.c + -DFOR_MSW) so no X11 headers or
        // libraries are needed (HAVE_XPM; -Dwith-xpm).  Fetched from the
        // official x.org release archive: gitlab.freedesktop.org's
        // tarballs intermittently fail on GitHub CI runners
        // (HttpConnectionClosing), the x.org archive mirror is stable.
        .xpm_src = .{
            .url = "https://xorg.freedesktop.org/archive/individual/lib/libXpm-3.5.17.tar.gz",
            .hash = "N-V-__8AAC4KKwAgFNbcsl3aZWqQ75uUpUrSAeLtfkKcxA3u",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "tools/gnutls-config/**",
        "tools/ncurses-config/**",
    },
}
