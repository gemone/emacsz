.{
    .name = .emacs,
    .fingerprint = 0x9075990b2e14f4b3,
    .version = "31.0.50",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The Gnulib .gl.h generator, extracted as an independent Zig
        // package (the first zon dependency; runtime gnulib/platform
        // packages will follow the same pattern).
        .gl_headers_gen = .{
            .path = "tools/gl-headers",
        },
        // The src/config.h generator, extracted as an independent Zig
        // package (mirrors gl_headers_gen above; reads the zig-authored
        // template + values and substitutes each #undef).
        .gen_config = .{
            .path = "tools/gen-config",
        },
        // The src/epaths.h generator, extracted as an independent Zig
        // package (mirrors gen_config above; formats the 11 PATH_* macros
        // from the absolute repo root passed as argv[1]).
        .gen_epaths = .{
            .path = "tools/gen-epaths",
        },
        // gnulib-str: gnulib string-primitive functions (memeq, streq)
        // provided by an independent Zig package instead of C
        // (lib/memeq.c, lib/streq.c). Linked into temacs to replace the
        // gnulib `extern inline` external definitions; direct byte/string
        // loops with no libc call. Follows the same path-dep pattern as the
        // build-time tool packages above.
        .gnulib_str = .{
            .path = "tools/gnulib-str",
        },
        // gnulib-ctype: gnulib's c-ctype character-classification
        // functions (c_isalpha, c_isdigit, c_tolower, ...) provided by an
        // independent Zig package instead of C (lib/c-ctype.c). Linked
        // into temacs; ASCII-only, exact semantic match, no libc call.
        .gnulib_ctype = .{
            .path = "tools/gnulib-ctype",
        },
        // gnulib-stdbit: gnulib's C23 <stdbit.h> bit-count functions
        // (stdc_leading_zeros/_trailing_zeros/_count_ones/_bit_width,
        // each _uc/_us/_ui/_ul/_ull) provided by an independent Zig
        // package instead of C (lib/stdc_*.c). Linked into temacs; exact
        // semantic match via @clz/@ctz/@popCount, no libc call.
        .gnulib_stdbit = .{
            .path = "tools/gnulib-stdbit",
        },
        // gnulib-hash: gnulib's cryptographic hashes (SHA1 first) provided
        // by an independent Zig package instead of C (lib/sha1.c). A
        // native Zig SHA1 operating on the gnulib struct sha1_ctx layout;
        // no libc call. Linked into temacs (backs `secure-hash').
        .gnulib_hash = .{
            .path = "tools/gnulib-hash",
        },
        // gnulib-sig2str: gnulib's signal name<->number conversion
        // (sig2str / str2sig, lib/sig2str.c) provided by an independent
        // Zig package instead of C. Pure table + string handling with
        // per-platform signal tables; no libc call. Linked into temacs
        // (backs signal-names and process signal parsing).
        .gnulib_sig2str = .{
            .path = "tools/gnulib-sig2str",
        },
        // gnulib-filemode: gnulib's file-mode string helpers (strmode,
        // filemodestring, lib/filemode.c) provided by an independent
        // Zig package instead of C. Pure string logic; no libc call.
        // Linked into temacs (backs file-attributes string mode element).
        .gnulib_filemode = .{
            .path = "tools/gnulib-filemode",
        },
        // gnulib-timespec: gnulib's timespec arithmetic (dtotimespec,
        // timespec_add, timespec_sub; lib/dtotimespec.c, lib/timespec-add.c,
        // lib/timespec-sub.c) provided by an independent Zig package
        // instead of C. Pure arithmetic; no libc call. Linked into temacs
        // (backs sit-for/sleep timeouts and gc timing).
        .gnulib_timespec = .{
            .path = "tools/gnulib-timespec",
        },
        // gnulib-filevercmp: gnulib's version-sort file name comparison
        // (filevercmp / filenvercmp, lib/filevercmp.c) provided by an
        // independent Zig package instead of C. Pure string logic; no
        // libc call. Linked into temacs (backs `string-version-lessp').
        .gnulib_filevercmp = .{
            .path = "tools/gnulib-filevercmp",
        },
        // emacs-time: gnulib's realtime-clock read (gettime /
        // current_timespec, lib/gettime.c) provided by an independent
        // Zig package with per-platform NATIVE backends (Linux raw
        // clock_gettime syscall; Windows kernel32 GetSystemTimeAsFileTime),
        // no libc. The first OS-layer subsystem ported under the "replace
        // the POSIX/sysdep layer with zig stdlib" strategy.
        .emacs_time = .{
            .path = "tools/emacs-time",
        },
        // emacs-nanosleep: gnulib's nanosleep (lib/nanosleep.c) provided
        // by an independent Zig package with per-platform NATIVE backends,
        // no libc: Linux std.os.linux.nanosleep raw syscall; Windows
        // kernel32 Sleep + QueryPerformanceCounter busy-wait. The second
        // OS-layer subsystem ported under the "replace the POSIX/sysdep
        // layer with zig stdlib" strategy.
        .emacs_nanosleep = .{
            .path = "tools/emacs-nanosleep",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
    },
}
